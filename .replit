modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0", "revenuecat:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY = "test_YBLjPglOOEgLBdWYsXOIrIRhlqL"
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY = "appl_CEcdrdMFWpfUsbxRcyBUKfqmzHD"
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY = "goog_qaBImqeAPHVuTpYJJBXcLwHzrKz"
REVENUECAT_PROJECT_ID = "proj067415b4"
REVENUECAT_TEST_STORE_APP_ID = "appb2b1bc0d99"
REVENUECAT_APPLE_APP_STORE_APP_ID = "appace4a121d5"
REVENUECAT_GOOGLE_PLAY_STORE_APP_ID = "appda1be853be"
PUBLIC_OBJECT_SEARCH_PATHS = "/replit-objstore-e239189d-4f2e-4c43-8795-0114827d221f"

[objectStorage]
defaultBucketID = "replit-objstore-e239189d-4f2e-4c43-8795-0114827d221f"
