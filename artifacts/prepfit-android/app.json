{
  "expo": {
    "name": "PrepFit Android",
    "slug": "prepfit-android",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prepfit-android",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#12151A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prepfit.app"
    },
    "android": {
      "package": "com.prepfit.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#12151A"
      },
      "versionCode": 23,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "PrepFit needs photo access to analyze your meals.",
          "cameraPermission": "PrepFit needs camera access to scan your meals."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "exclude": [
                "META-INF/versions/9/OSGI-INF/MANIFEST.MF"
              ]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/5a0f2ba7-594b-4d58-87b4-1d2c662c2fe7"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "5a0f2ba7-594b-4d58-87b4-1d2c662c2fe7"
      }
    },
    "owner": "jammer5050"
  }
}
